{
  "name": "decky-crt-filter",
  "version": "0.1.0",
  "description": "Decky Loader plugin that applies a CRT shader to the whole SteamOS Game Mode screen through gamescope's built-in ReShade support",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "decky",
    "plugin",
    "steamos",
    "gamescope",
    "reshade",
    "crt"
  ],
  "author": "Thomas Clark",
  "license": "BSD-3-Clause",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.16.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "rollup": "^4.67.2",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-musl": "^4.67.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.7.0",
    "tslib": "^2.9.1"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
